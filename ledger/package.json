{
  "name": "paisa-ledger",
  "productName": "Paisa Ledger",
  "version": "2.0.0",
  "description": "Offline-first expense tracker: statement analyser, subscription tracker, tax helper and planner.",
  "author": "Paisa Ledger",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/SrinathRavi10/Action-Recognition-in-Videos-ft-SRINATH-clzv3.git" },
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "python3 serve.py",
    "desktop": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.paisaledger.app",
    "productName": "Paisa Ledger",
    "copyright": "MIT",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["index.html", "styles.css", "manifest.webmanifest", "js/**/*", "vendor/**/*", "icons/**/*", "desktop/**/*", "build/icon.png", "package.json"],
    "asar": true,
    "compression": "normal",
    "win": { "icon": "build/icon.ico", "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Paisa Ledger" },
    "portable": { "artifactName": "PaisaLedger-Portable-${version}.exe" },
    "mac": { "icon": "build/icon.png", "category": "public.app-category.finance", "target": ["dmg"] },
    "linux": { "icon": "build/icon.png", "category": "Office", "target": ["AppImage"] },
    "artifactName": "PaisaLedger-Setup-${version}.${ext}"
  }
}
